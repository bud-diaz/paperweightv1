{
  "name": "paperweight",
  "version": "1.5.1",
  "description": "Self-hosted creator-first streaming and distribution.",
  "repository": {
    "type": "git",
    "url": "https://github.com/bud-diaz/paper-packs"
  },
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon --config nodemon.json scripts/dev-server.js",
    "dev:plain": "nodemon src/index.js",
    "dev:desktop": "nodemon --config nodemon.electron.json --exec node scripts/dev-electron.js",
    "preflight": "node scripts/preflight.js",
    "check:migrations": "node scripts/check-migrations.js",
    "check:scheduler": "node scripts/check-scheduler.js",
    "check:analytics": "node scripts/check-analytics.js",
    "check:package": "node scripts/check-package-assets.js",
    "check:dashboard": "node scripts/check-dashboard-contract.js",
    "backup": "node scripts/backup.js",
    "smoke": "node scripts/smoke.js",
    "smoke:exe": "node scripts/smoke-exe.js",
    "build:desktop-runtime": "node scripts/build-desktop-runtime.js",
    "check:desktop-artifact": "node scripts/check-desktop-artifact.js",
    "test": "node --test test/build-scripts.test.js test/broadcast-engine.test.js test/broadcast-live-external.test.js test/broadcast-live-video.test.js test/scheduler.test.js test/access.test.js test/payment.test.js test/http.test.js test/auth.test.js test/devices.test.js test/reserved-slugs.test.js test/platform.test.js test/provision.test.js test/device-lock.test.js test/security.test.js test/email.test.js test/features.test.js test/papercut-adoption.test.js test/release-scheduler.test.js test/cloudflare.test.js",
    "check:clean": "node scripts/check-release-clean.js",
    "release:check": "node scripts/check-release-clean.js && npm test && node scripts/preflight.js && node scripts/check-migrations.js && node scripts/check-scheduler.js && node scripts/check-analytics.js && node scripts/check-package-assets.js && node scripts/check-dashboard-contract.js && npm audit --omit=dev",
    "fetch:ffmpeg": "node scripts/fetch-ffmpeg.js",
    "build:exe": "node scripts/build-exe.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.8.0",
    "chokidar": "^3.6.0",
    "cookie-parser": "^1.4.6",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "hls.js": "^1.6.16",
    "matter-js": "^0.20.0",
    "multer": "^2.2.0",
    "stripe": "^17.0.0"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^5.12.0",
    "nodemon": "^3.1.0",
    "terser": "^5.49.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "pkg": {
    "scripts": [
      "src/**/*.js",
      "scripts/preflight.js",
      "scripts/check-migrations.js",
      "scripts/check-scheduler.js",
      "scripts/check-analytics.js",
      "scripts/check-package-assets.js",
      "scripts/check-release-clean.js",
      "scripts/smoke.js",
      "scripts/smoke-exe.js"
    ],
    "assets": [
      "package.json"
    ],
    "targets": [
      "node20-linux-x64",
      "node20-linux-arm64"
    ],
    "outputPath": "dist"
  }
}

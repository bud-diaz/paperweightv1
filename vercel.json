{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "destination": "/landing/index.html"
    },
    {
      "source": "/download",
      "destination": "/landing/download.html"
    },
    {
      "source": "/listen",
      "destination": "/landing/listen.html"
    },
    {
      "source": "/license",
      "destination": "/landing/license.html"
    },
    {
      "source": "/content-responsibility",
      "destination": "/landing/content-responsibility.html"
    }
  ]
}

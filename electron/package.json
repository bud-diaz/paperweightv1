{
  "name": "paperweight-desktop",
  "version": "1.5.1",
  "private": true,
  "description": "Paperweight desktop app (Windows, macOS & Linux)",
  "main": "main.js",
  "homepage": "https://github.com/bud-diaz/paperweightv1",
  "scripts": {
    "start": "electron main.js",
    "electron:rebuild": "node scripts/rebuild-native.js",
    "stage:runtime": "node ../scripts/build-desktop-runtime.js",
    "check:artifact": "node ../scripts/check-desktop-artifact.js",
    "dist": "npm run electron:rebuild && npm run stage:runtime && electron-builder --mac --win && npm run check:artifact",
    "dist:win": "npm run electron:rebuild && npm run stage:runtime && electron-builder --win && npm run check:artifact",
    "dist:linux": "npm run electron:rebuild && npm run stage:runtime && electron-builder --linux && npm run check:artifact",
    "dist:mac-universal": "npm run electron:rebuild && npm run electron:rebuild -- --arch arm64 && npm run electron:rebuild -- --arch x64 && npm run stage:runtime && electron-builder --config electron-builder.universal.json --mac && npm run check:artifact"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "@electron/rebuild": "^3.6.0"
  },
  "build": {
    "appId": "com.paperweight.desktop",
    "productName": "Paperweight",
    "directories": {
      "output": "dist"
    },
    "asar": true,
    "files": [
      "**/*",
      "!dist/**",
      "!native/**",
      "!stage/**",
      "!.stage-work/**"
    ],
    "extraResources": [
      { "from": "stage/src", "to": "src" },
      { "from": "stage/node_modules", "to": "node_modules" },
      { "from": "stage/package.json", "to": "package.json" }
    ],
    "mac": {
      "target": ["dmg", "zip"],
      "icon": "build/icon.icns",
      "category": "public.app-category.music"
    },
    "win": {
      "target": ["nsis"],
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "build/icon.png",
      "category": "Audio",
      "synopsis": "Self-hosted, creator-first streaming and distribution",
      "maintainer": "Paperweight Systems LLC <rollingwoodsmedia@gmail.com>"
    }
  }
}

{
  "name": "paperweight-desktop",
  "version": "1.5.1",
  "private": true,
  "description": "Paperweight desktop app (Windows, macOS & Linux)",
  "main": "main.js",
  "homepage": "https://github.com/bud-diaz/paperweightv1",
  "scripts": {
    "start": "electron main.js",
    "icons": "node scripts/generate-icons.js",
    "electron:rebuild": "node scripts/rebuild-native.js",
    "stage:runtime": "node ../scripts/build-desktop-runtime.js",
    "check:artifact": "node ../scripts/check-desktop-artifact.js",
    "dist": "node scripts/dist.js",
    "dist:win": "node scripts/dist.js --target win32",
    "dist:linux": "node scripts/dist.js --target linux",
    "dist:mac-universal": "node scripts/dist.js --target darwin"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "@electron/rebuild": "^3.6.0"
  },
  "build": {
    "appId": "com.paperweight.desktop",
    "productName": "Paperweight",
    "directories": {
      "output": "dist"
    },
    "asar": true,
    "files": [
      "**/*",
      "!dist/**",
      "!native/**",
      "!stage/**",
      "!.stage-work/**"
    ],
    "extraResources": [
      { "from": "stage/src", "to": "src" },
      { "from": "stage/node_modules", "to": "node_modules" },
      { "from": "stage/package.json", "to": "package.json" },
      { "from": "stage/bin", "to": "bin" },
      { "from": "../CONTENT RESPONSIBILITY.txt", "to": "CONTENT RESPONSIBILITY.txt" },
      { "from": "../LICENSE.txt", "to": "LICENSE.txt" },
      { "from": "../THIRD-PARTY NOTICE.txt", "to": "THIRD-PARTY NOTICE.txt" }
    ],
    "mac": {
      "target": ["dmg", "zip"],
      "icon": "build/icon.icns",
      "category": "public.app-category.music"
    },
    "win": {
      "target": ["nsis"],
      "icon": "build/icon.ico",
      "executableName": "Paperweight"
    },
    "nsis": {
      "artifactName": "Paperweight-Setup-${version}.${ext}",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "shortcutName": "Paperweight"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "build/icons",
      "category": "Audio",
      "synopsis": "Self-hosted, creator-first streaming and distribution",
      "maintainer": "Paperweight Systems LLC <rollingwoodsmedia@gmail.com>"
    }
  }
}
